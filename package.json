{
  "name": "mk-kit",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:theme && ng serve docs",
    "build": "ng build docs",
    "build:theme": "sass projects/mk-kit/src/styles/mk-kit.scss projects/mk-kit/src/styles/mk-kit.css --no-source-map --style expanded --no-charset",
    "build:lib": "npm run build:theme && ng build mk-kit",
    "watch:lib": "ng build mk-kit --watch --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test mk-kit --no-watch",
    "test:lib": "ng test mk-kit --no-watch",
    "test:docs": "ng test docs --no-watch"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/platform-server": "^22.0.5",
    "axe-core": "^4.12.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.8.1",
    "sass": "^1.101.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
