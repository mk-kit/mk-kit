# @mkornas/* is published to GitHub Packages (private).
# The scope→registry mapping lets `npm install`/`npm ci` resolve it.
# Auth is supplied at runtime via NODE_AUTH_TOKEN (CI: GITHUB_TOKEN; locally:
# a PAT with read:packages) — never commit a real token here.
@mkornas:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
