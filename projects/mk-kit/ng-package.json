{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/mk-kit",
  "assets": [
    {
      "input": "./src/styles",
      "glob": "**/*.css",
      "output": "./styles"
    },
    {
      "input": ".",
      "glob": "THIRD_PARTY_NOTICES.md",
      "output": "."
    }
  ],
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "allowedNonPeerDependencies": [
    "@mk-kit/validators"
  ]
}
